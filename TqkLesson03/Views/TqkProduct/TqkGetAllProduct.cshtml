@{
    ViewData["Title"] = "Danh sách sản phẩm";

    var products = ViewData["products"] as List<TqkLesson03.Models.TqkProduct>;
    int stt = 0;
}

<div class="card">
    <div class="card-header">
        <h1>@ViewData["Title"]</h1>
    </div>

    <div class="card-body">
        <table class="table table-bordered table-striped">
            <thead>
                <tr>
                    <th>#</th>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Year</th>
                    <th>Price</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @if (products != null)
                {
                    foreach (TqkLesson03.Models.TqkProduct item in products)
                    {
                        stt++;
                        <tr>
                            <td>@stt</td>
                            <td>@item.TqkProductId</td>
                            <td>@item.TqkProductName</td>
                            <td>@item.TqkYearRelease</td>
                            <td>@item.TqkPrice</td>
                            <td>
                                <a href="#">Xem</a>
                                <a href="#">Sửa</a>
                                <a href="#">Xóa</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                 <tr>
                    <th colspan="6">Tổng số sản phẩm: @(products?.Count ?? 0)</th>
                 </tr>
            </tfoot>
        </table>
    </div>
</div>